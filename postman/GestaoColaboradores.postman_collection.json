            }
          }
        },
        {
          "name": "PATCH sem nenhum campo (esperado 400)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/v1/usuarios/{{usuarioId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
