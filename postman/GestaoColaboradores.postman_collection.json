    {
      "name": "Colaboradores",
      "item": [
        {
          "name": "Listar",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/colaboradores"
          }
        },
        {
          "name": "Criar em unidade ativa",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 com codigo COLnnnnnn', function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(pm.response.json().codigo).to.match(/^COL[0-9]{6}$/);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    pm.environment.set('colaboradorId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/colaboradores",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Novo Colaborador\",\n  \"unidadeId\": \"{{unidadeAtivaId}}\",\n  \"usuarioId\": \"{{usuarioId}}\"\n}"
            }
          }
        },
        {
          "name": "Obter por id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/colaboradores/{{colaboradorId}}"
          }
        },
        {
          "name": "Criar em unidade INATIVA (esperado 422 - regra central)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 por unidade inativa', function () {",
                  "    pm.response.to.have.status(422);",
                  "    pm.expect(pm.response.json().detail).to.include('inativa');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/colaboradores",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Deve Falhar\",\n  \"unidadeId\": \"{{unidadeInativaId}}\",\n  \"usuarioId\": \"{{usuarioId}}\"\n}"
            }
          }
        },
        {
          "name": "Criar com unidade inexistente (esperado 404)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/colaboradores",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Sem Unidade\",\n  \"unidadeId\": \"00000000-0000-0000-0000-000000000000\",\n  \"usuarioId\": \"{{usuarioId}}\"\n}"
            }
          }
        },
        {
          "name": "PUT - substitui nome e unidade",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/colaboradores/{{colaboradorId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Nome Atualizado\",\n  \"unidadeId\": \"{{unidadeAtivaId}}\"\n}"
            }
          }
        },
