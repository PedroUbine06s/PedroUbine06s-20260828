{
  "info": {
    "name": "Gestão de Colaboradores e Unidades",
    "description": "Rode o login primeiro: ele salva o token no environment. Os codigos (USR000001, UNI000001, COL000001) sao gerados pelo sistema, e as referencias sao feitas por Id (UUID) - por isso as criacoes guardam o Id da resposta em variaveis e as requisicoes seguintes as reutilizam. Rode as pastas na ordem.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (salva o token automaticamente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 e token recebido', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().token).to.be.a('string');",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    pm.environment.set('token', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"admin\",\n  \"senha\": \"admin123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login com senha errada (esperado 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 com mensagem generica', function () {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.json().detail).to.include('inv');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"admin\",\n  \"senha\": \"senhaerrada\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login de usuario inativo (esperado 401)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"carlos.lima\",\n  \"senha\": \"senha123\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Sem token (esperado 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/colaboradores",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Unidades",
      "item": [
        {
          "name": "Listar com colaboradores (guarda os Ids do seed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const unidades = pm.response.json();",
                  "pm.test('unidades vem com colaboradores aninhados', function () {",
                  "    pm.expect(unidades.length).to.be.above(0);",
                  "});",
                  "const ativa = unidades.find(u => u.ativo);",
                  "const inativa = unidades.find(u => !u.ativo);",
                  "if (ativa) pm.environment.set('unidadeAtivaId', ativa.id);",
                  "if (inativa) pm.environment.set('unidadeInativaId', inativa.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/unidades"
          }
        },
        {
          "name": "Obter por id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/unidades/{{unidadeAtivaId}}"
          }
        },
        {
          "name": "Criar (codigo gerado pelo sistema)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 com codigo UNInnnnnn e header Location', function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(pm.response.json().codigo).to.match(/^UNI[0-9]{6}$/);",
                  "    pm.expect(pm.response.headers.get('Location')).to.be.a('string');",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    pm.environment.set('unidadeId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/unidades",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Filial Norte\"\n}"
            }
          }
        },
        {
          "name": "PUT - substitui nome e status (exige os dois)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/unidades/{{unidadeId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Filial Norte\",\n  \"ativo\": true\n}"
            }
          }
        },
        {
          "name": "PUT sem o nome (esperado 400 - PUT exige tudo)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/unidades/{{unidadeId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ativo\": false\n}"
            }
          }
        },
        {
          "name": "PATCH - inativa mandando so o status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 e unidade inativa', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().ativo).to.eql(false);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/v1/unidades/{{unidadeId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ativo\": false\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Listar todos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/usuarios"
          }
        },
        {
          "name": "Listar apenas inativos (requisito do enunciado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('todos vem inativos', function () {",
                  "    pm.response.json().forEach(u => pm.expect(u.ativo).to.eql(false));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/usuarios?ativo=false"
          }
        },
        {
          "name": "Criar (codigo gerado pelo sistema)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 com codigo USRnnnnnn', function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(pm.response.json().codigo).to.match(/^USR[0-9]{6}$/);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    pm.environment.set('usuarioId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/usuarios",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"novo.usuario\",\n  \"senha\": \"senha123\",\n  \"ativo\": true\n}"
            }
          }
        },
        {
          "name": "Obter por id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/usuarios/{{usuarioId}}"
          }
        },
        {
          "name": "Criar com login duplicado (esperado 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/usuarios",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"admin\",\n  \"senha\": \"senha123\",\n  \"ativo\": true\n}"
            }
          }
        },
        {
          "name": "Criar com senha curta (esperado 400)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/usuarios",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"senha.curta\",\n  \"senha\": \"123\",\n  \"ativo\": true\n}"
            }
          }
        },
        {
          "name": "PUT - substitui senha e status",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/usuarios/{{usuarioId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senha\": \"novaSenha123\",\n  \"ativo\": true\n}"
            }
          }
        },
        {
          "name": "PATCH - inativa sem tocar na senha",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/v1/usuarios/{{usuarioId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ativo\": false\n}"
            }
          }
        },
        {
          "name": "PATCH sem nenhum campo (esperado 400)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/v1/usuarios/{{usuarioId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        },
        {
          "name": "Obter id inexistente (esperado 404)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/usuarios/00000000-0000-0000-0000-000000000000"
          }
        }
      ]
    },
    {
      "name": "Colaboradores",
      "item": [
        {
          "name": "Listar",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/colaboradores"
          }
        },
        {
          "name": "Criar em unidade ativa",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 com codigo COLnnnnnn', function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(pm.response.json().codigo).to.match(/^COL[0-9]{6}$/);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    pm.environment.set('colaboradorId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/colaboradores",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Novo Colaborador\",\n  \"unidadeId\": \"{{unidadeAtivaId}}\",\n  \"usuarioId\": \"{{usuarioId}}\"\n}"
            }
          }
        },
        {
          "name": "Obter por id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/colaboradores/{{colaboradorId}}"
          }
        },
        {
          "name": "Criar em unidade INATIVA (esperado 422 - regra central)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 por unidade inativa', function () {",
                  "    pm.response.to.have.status(422);",
                  "    pm.expect(pm.response.json().detail).to.include('inativa');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/colaboradores",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Deve Falhar\",\n  \"unidadeId\": \"{{unidadeInativaId}}\",\n  \"usuarioId\": \"{{usuarioId}}\"\n}"
            }
          }
        },
        {
          "name": "Criar com unidade inexistente (esperado 404)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/colaboradores",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Sem Unidade\",\n  \"unidadeId\": \"00000000-0000-0000-0000-000000000000\",\n  \"usuarioId\": \"{{usuarioId}}\"\n}"
            }
          }
        },
        {
          "name": "PUT - substitui nome e unidade",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/colaboradores/{{colaboradorId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Nome Atualizado\",\n  \"unidadeId\": \"{{unidadeAtivaId}}\"\n}"
            }
          }
        },
        {
          "name": "PATCH - renomeia sem reenviar a unidade",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/v1/colaboradores/{{colaboradorId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"So o Nome Mudou\"\n}"
            }
          }
        },
        {
          "name": "PATCH transferindo para unidade inativa (esperado 422)",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/v1/colaboradores/{{colaboradorId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unidadeId\": \"{{unidadeInativaId}}\"\n}"
            }
          }
        },
        {
          "name": "Remover (204 - e inativa o usuario vinculado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/colaboradores/{{colaboradorId}}"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    }
  ]
}