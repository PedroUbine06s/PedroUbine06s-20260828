<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <!-- Exigido pelas EF Tools NO PROJETO DE STARTUP para gerar migrations. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Swashbuckle continua sendo a fonte da UI: Microsoft.AspNetCore.OpenApi gera o documento, mas não tem interface. -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="SharpGrip.FluentValidation.AutoValidation.Mvc" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GestaoColaboradores.Application\GestaoColaboradores.Application.csproj" />
    <ProjectReference Include="..\GestaoColaboradores.Infrastructure\GestaoColaboradores.Infrastructure.csproj" />
  </ItemGroup>

</Project>
