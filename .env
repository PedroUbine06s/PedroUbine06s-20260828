# Valores de DESENVOLVIMENTO, versionados de propósito: o banco é um contêiner
# descartável, recriado a cada "docker compose up", e nada aqui protege dado real.
# Versionar permite clonar e rodar sem nenhum passo de configuração.
#
# Em produção estes mesmos nomes são injetados como variáveis de ambiente pelo
# orquestrador, que têm precedência sobre este arquivo — nada precisa mudar no
# docker-compose.yml.

POSTGRES_USER=gestao
POSTGRES_PASSWORD=gestao123
POSTGRES_DB=gestao_colaboradores

# Mínimo de 32 caracteres: a API valida o tamanho na inicialização.
JWT_SECRET=segredo-do-compose-trocar-em-producao-32c

# O padrão do código é 5/min, adequado a um login exposto na internet. Aqui é
# folgado de propósito: a collection do Postman faz 3 logins por execução, e 5
# transformaria explorar a API em esbarrar em 429.
RATE_LIMIT_LOGIN_POR_MINUTO=20
